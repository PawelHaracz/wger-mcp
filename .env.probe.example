# Copy to .env.probe (gitignored) and fill in. Used by scripts/probe_exchange.py
# to verify the live OIDC -> wger token-exchange chain.

MCP_AUTH=oidc

# wger 2.6 base URL (must be reachable from where you run the probe).
WGER_BASE_URL=https://wger.YOURDOMAIN

# OIDC issuer (the realm/tenant wger uses for OIDC login).
OIDC_ISSUER=https://auth.YOURDOMAIN/realms/REALM

# This MCP server's confidential OIDC client (token-exchange enabled),
# permitted to exchange to the wger client's audience.
OIDC_CLIENT_ID=wger-mcp
OIDC_CLIENT_SECRET=...

# wger's OIDC client id at the IdP (the exchange target audience).
WGER_OIDC_AUDIENCE=wger

# allauth provider id of the OIDC connection in wger (SocialApp.provider_id).
# Often "openid_connect", but may be a custom slug set in wger admin — match it.
WGER_ALLAUTH_PROVIDER=openid_connect

# OPTIONAL. An OIDC user access token, standing in for what a real MCP client
# would carry. Leave EMPTY and scripts/e2e.sh logs you in via device
# flow automatically (you approve once in a browser) — requires "OAuth 2.0 Device
# Authorization Grant" enabled on OIDC_CLIENT_ID. Only set this if you'd
# rather paste a token obtained some other way.
SUBJECT_TOKEN=
